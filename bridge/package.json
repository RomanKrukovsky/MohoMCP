{
  "name": "moho-mcp",
  "version": "0.1.0",
  "description": "Enterprise MCP bridge server for MOHO 14 animation software",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "moho-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "sbom": "node -e \"console.log(JSON.stringify(require('./package.json'), null, 2))\" > sbom.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.5.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
